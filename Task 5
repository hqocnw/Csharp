using System;

class Box<T>
{
    T item;
    
    public void Put(T item)
    {
        this.item = item;
    }
    
    public T Get()
    {
        return item;
    }
}

class Utils
{
    public static void Swap<T>(ref T a, ref T b)
    {
        T temp = a;
        a = b;
        b = temp;
    }
}

class Pair<T1, T2>
{
    public T1 first;
    public T2 second;
    
    public Pair(T1 f, T2 s)
    {
        first = f;
        second = s;
    }
}

class Program
{
    static void Main()
    {
        Box<int> box1 = new Box<int>();
        box1.Put(42);
        
        Box<string> box2 = new Box<string>();
        box2.Put("Hello");
        
        Console.WriteLine("Число в коробке: " + box1.Get());
        Console.WriteLine("Строка в коробке: " + box2.Get());
        
        int a = 5, b = 10;
        Utils.Swap(ref a, ref b);
        Console.WriteLine("Числа после Swap: " + a + ", " + b);
        
        string s1 = "Hello", s2 = "World";
        Utils.Swap(ref s1, ref s2);
        Console.WriteLine("Строки после Swap: " + s1 + ", " + s2);
        
        Pair<int, string> p = new Pair<int, string>(5, "Hello");
        Console.WriteLine("Первое значение: " + p.first + ", Второе значение: " + p.second);
        
        Console.ReadKey();
    }
}
